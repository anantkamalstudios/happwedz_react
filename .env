# Origin serving vendor/venue media stored in the happywedz-s3-bucket.
# Leave unset to hit the bucket directly (requires public read on uploads/*);
# set it to a CloudFront domain once one is in front of the bucket.
# VITE_IMAGE_CDN_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# Origin of the HappyWedz Store subdomain. The dashboard reads the store
# basket from this origin's localStorage through /cart-bridge.html.
VITE_STORE_ORIGIN=https://store.happywedz.com
# Reading the store basket needs cart-bridge.html served from the store
# origin, which is a codebase we do not control. Leave false until that
# file returns 200 at ${VITE_STORE_ORIGIN}/cart-bridge.html.
VITE_STORE_CART_BRIDGE=false
